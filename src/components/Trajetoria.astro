---
import SectionHead from './SectionHead.astro';
import { trajetoria, contato } from '../content/perfil';
---

<section id="trajetoria" class="section section--alt" aria-labelledby="trajetoria-titulo">
  <div class="container">
    <SectionHead id="trajetoria-titulo" numero="04" rotulo="Trajetória" titulo="Onde estive" />

    <ol class="timeline" role="list">
      {
        trajetoria.map((etapa) => (
          <li class="timeline__item">
            <span class="timeline__marker" aria-hidden="true" />
            <p class="label timeline__periodo">{etapa.periodo}</p>
            <h3 class="timeline__cargo">{etapa.cargo}</h3>
            <p class="timeline__lugar">{etapa.lugar}</p>
            {etapa.itens.length > 0 && (
              <ul class="bullets timeline__itens">
                {etapa.itens.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    <div class="timeline__fim">
      <a class="btn btn--outline" href={contato.linkedin.url} target="_blank" rel="noopener noreferrer">
        Ver no LinkedIn ↗<span class="sr-only"> (abre em nova aba)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 48px;
    margin: 0;
    padding: 0 0 0 36px;
    list-style: none;
  }

  /* a linha vertical */
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--line);
  }

  .timeline__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 820px;
  }

  .timeline__marker {
    position: absolute;
    left: -36px;
    top: 2px;
    width: 12px;
    height: 12px;
    background: var(--bg-alt);
    border: 2px solid var(--accent);
    transform: rotate(45deg);
  }

  .timeline__item:first-child .timeline__marker {
    background: var(--accent);
  }

  .timeline__cargo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .timeline__lugar {
    color: var(--text-3);
    font-size: 15px;
  }

  .timeline__itens {
    gap: 8px;
    margin-top: 10px;
  }

  .timeline__fim {
    margin-top: 48px;
  }
</style>
