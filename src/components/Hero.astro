---
import { pessoa, construo } from '../content/perfil';
import RegMarks from './RegMarks.astro';

const [primeiroA, primeiroB] = construo[0];
const apelido = pessoa.apelido.toUpperCase();

// Frase inteira para leitores de tela: "plataformas para equipes, ..., e dashboards para decisões."
const partes = construo.map(([a, b]) => `${a} para ${b}`);
const fraseCompleta = `Eu construo ${partes.slice(0, -1).join(', ')} e ${partes.at(-1)}.`;
---

<section id="topo" class="hero" aria-labelledby="hero-titulo">
  <div class="scanlines" aria-hidden="true"></div>
  <RegMarks class="hero__marks" linhas={['ESCANEANDO: PERFIL_01', 'FREQ: 7.3 MHz', 'KEY-1']} />
  <div class="container hero__inner">
    <p class="hero__status">
      <span class="hero__dot" aria-hidden="true"></span>
      <span class="label label--muted">// {pessoa.status}</span>
    </p>

    <div class="hero__id">
      <h1 id="hero-titulo" class="hero__title">
        <span class="sr-only">{pessoa.nomeCompleto} ({pessoa.apelido})</span>
        <button
          type="button"
          class="hero__name"
          aria-label="Alternar entre o apelido e o nome completo"
          data-hero-title
          data-apelido={apelido}
          data-nome={pessoa.nomeCompleto}
        >
          <span class="hero__fallback" aria-hidden="true" data-hero-fallback>{apelido}</span>
        </button>
      </h1>
      <p class="hero__hint" aria-hidden="true">// Passe o mouse ou toque para ver o nome completo</p>
    </div>

    <p class="hero__role">
      {pessoa.cargo} <span class="accent-text">//</span>{' '}{pessoa.local}
    </p>

    <p class="hero__sub" data-construo={JSON.stringify(construo)}>
      <span class="sr-only">{fraseCompleta}</span>
      <span aria-hidden="true">
        Eu construo <span class="hero__word" data-px-slot="0">{primeiroA}</span> para{' '}
        <span class="hero__word" data-px-slot="1">{primeiroB}.</span>
      </span>
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="/conversa">Conversar com o Caio ▸</a>
      <a class="btn btn--outline" href="#projetos">Ver projetos</a>
    </div>
  </div>
</section>

<script>
  import { initConstruo } from '../scripts/pixel-text';
  import { initHeroTitle } from '../scripts/hero-title';
  import { afterBoot } from '../scripts/boot';

  // As animações começam depois do boot, para serem vistas
  afterBoot(() => {
    const title = document.querySelector<HTMLButtonElement>('[data-hero-title]');
    if (title) {
      initHeroTitle(title, { apelido: title.dataset.apelido ?? '', nome: title.dataset.nome ?? '' }).catch(() => {
        /* fica o texto do HTML */
      });
    }

    const sub = document.querySelector<HTMLElement>('[data-construo]');
    if (sub) {
      try {
        const pairs = JSON.parse(sub.dataset.construo ?? '[]') as [string, string][];
        initConstruo(sub, pairs);
      } catch {
        /* fica a frase estática do HTML */
      }
    }
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    /* brilho vinho em cima à direita, teal embaixo à esquerda, sobre a grade de 48px */
    background-image:
      radial-gradient(ellipse 60% 70% at 85% 10%, var(--glow-a), transparent 70%),
      radial-gradient(ellipse 70% 80% at 10% 100%, var(--glow-b), transparent 70%),
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size:
      auto,
      auto,
      var(--grid-size) var(--grid-size),
      var(--grid-size) var(--grid-size);
  }

  .hero :global(.hero__marks) {
    position: absolute;
    top: 56px;
    right: max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter)));
    transition: opacity 0.25s;
  }

  /* o nome completo ocupa a largura toda: as marcas saem do caminho */
  .hero:has([data-hero-title][data-target='nome']) :global(.hero__marks) {
    opacity: 0;
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(64px, 11vw, 112px) clamp(72px, 12vw, 120px);
  }

  .hero__status {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    animation: blink 1.6s ease-in-out infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  .hero__id {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero__title {
    /* tamanho do apelido; o canvas tem altura fixa de 1,5 × isto (CLS 0) */
    --title-fs: clamp(44px, 9.4vw, 120px);
    margin: 0;
  }

  .hero__name {
    display: block;
    width: fit-content;
    max-width: 100%;
    height: calc(var(--title-fs) * 1.5);
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--title-fs);
    line-height: 1.5;
    color: var(--text);
  }

  .hero__fallback {
    display: block;
    white-space: nowrap;
  }

  .hero__name :global(.hero__canvas) {
    display: block;
    max-width: 100%;
  }

  .hero__hint {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* sem JavaScript o hover não troca nada: a dica fica invisível (sem mexer no layout) */
  .hero__title:not(.is-pixel) + .hero__hint {
    visibility: hidden;
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.6vw, 16px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }

  .hero__sub {
    max-width: 900px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.7;
    color: var(--text);
  }

  /* palavras em --accent: bold ≥ 18,66px conta como texto grande (3:1) */
  .hero__word {
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 8px;
  }

  :global(.px-canvas) {
    display: inline-block;
  }
</style>
