---
import { pessoa, construo } from '../content/perfil';

const [primeiroA, primeiroB] = construo[0];

// Frase inteira para leitores de tela: "plataformas para equipes, ..., e dashboards para decisões."
const partes = construo.map(([a, b]) => `${a} para ${b}`);
const fraseCompleta = `Eu construo ${partes.slice(0, -1).join(', ')} e ${partes.at(-1)}.`;
---

<section id="topo" class="hero" aria-labelledby="hero-titulo">
  <div class="scanlines" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="hero__status">
      <span class="hero__dot" aria-hidden="true"></span>
      <span class="label label--muted">// {pessoa.status}</span>
    </p>

    <div class="hero__id">
      <h1 id="hero-titulo" class="hero__title">
        <span>{pessoa.nome}</span>
        <span class="hero__surname">{pessoa.sobrenome}</span>
      </h1>

      <button type="button" class="hero__nick" aria-label={pessoa.apelido} data-apelido={pessoa.apelido}>
        <span data-px-host>{pessoa.apelido}</span>
      </button>
    </div>

    <p class="hero__role">
      {pessoa.cargo} <span class="accent-text">//</span>{' '}{pessoa.local}
    </p>

    <p class="hero__sub" data-construo={JSON.stringify(construo)}>
      <span class="sr-only">{fraseCompleta}</span>
      <span aria-hidden="true">
        Eu construo <span class="hero__word" data-px-slot="0">{primeiroA}</span> para{' '}
        <span class="hero__word" data-px-slot="1">{primeiroB}.</span>
      </span>
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="/conversa">Conversar com o Caio ▸</a>
      <a class="btn btn--outline" href="#projetos">Ver projetos</a>
    </div>
  </div>
</section>

<script>
  import { initApelido, initConstruo } from '../scripts/pixel-text';
  import { afterBoot } from '../scripts/boot';

  // As animações começam depois do boot, para serem vistas
  afterBoot(() => {
    const nick = document.querySelector<HTMLButtonElement>('[data-apelido]');
    if (nick) initApelido(nick, nick.dataset.apelido ?? '');

    const sub = document.querySelector<HTMLElement>('[data-construo]');
    if (sub) {
      try {
        const pairs = JSON.parse(sub.dataset.construo ?? '[]') as [string, string][];
        initConstruo(sub, pairs);
      } catch {
        /* fica a frase estática do HTML */
      }
    }
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    /* brilho vinho em cima à direita, teal embaixo à esquerda, sobre a grade de 48px */
    background-image:
      radial-gradient(ellipse 60% 70% at 85% 10%, var(--glow-a), transparent 70%),
      radial-gradient(ellipse 70% 80% at 10% 100%, var(--glow-b), transparent 70%),
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size:
      auto,
      auto,
      var(--grid-size) var(--grid-size),
      var(--grid-size) var(--grid-size);
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(64px, 11vw, 112px) clamp(72px, 12vw, 120px);
  }

  .hero__status {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    animation: blink 1.6s ease-in-out infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  .hero__id {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero__title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h1);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--text);
  }

  .hero__surname {
    color: var(--accent);
  }

  .hero__nick {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 1.2;
    color: var(--text);
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.6vw, 16px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }

  .hero__sub {
    max-width: 900px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.7;
    color: var(--text);
  }

  /* palavras em --accent: bold ≥ 18,66px conta como texto grande (3:1) */
  .hero__word {
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 8px;
  }

  :global(.px-canvas) {
    display: inline-block;
  }
</style>
