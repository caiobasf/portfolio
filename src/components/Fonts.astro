---
/**
 * Fontes auto-hospedadas, só o subconjunto latino (cobre português: á, ã, ç, ê…).
 * Declaradas à mão para não gerar arquivos de cirílico/grego/vietnamita no build.
 * JetBrains Mono (título CAIOBASF, subtítulo, rótulos) é pré-carregada porque
 * aparece no topo da página.
 */
import rajdhani500 from '@fontsource/rajdhani/files/rajdhani-latin-500-normal.woff2?url';
import rajdhani600 from '@fontsource/rajdhani/files/rajdhani-latin-600-normal.woff2?url';
import rajdhani700 from '@fontsource/rajdhani/files/rajdhani-latin-700-normal.woff2?url';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const face = (family: string, weight: string, src: string, variable = false) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};` +
  `src:url(${src}) format('${variable ? 'woff2-variations' : 'woff2'}');unicode-range:${latin}}`;

const css = [
  face('Rajdhani', '500', rajdhani500),
  face('Rajdhani', '600', rajdhani600),
  face('Rajdhani', '700', rajdhani700),
  face('Inter Variable', '100 900', inter, true),
  face('JetBrains Mono Variable', '100 800', mono, true),
].join('');

interface Props {
  /** URLs a pré-carregar (padrão: título e mono do hero) */
  preload?: boolean;
}
const { preload = true } = Astro.props;
---

{
  preload && (
    <>
      <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    </>
  )
}
<style is:inline set:html={css}></style>
