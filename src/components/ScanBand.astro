---
/**
 * Faixa de listras de scanner entre o hero e o "Sobre" (spec 2, §6.2).
 * Decorativa. Sem JavaScript fica um fundo de linhas retas em CSS.
 */
---

<div class="band" aria-hidden="true" data-scan-band>
  <canvas class="band__canvas"></canvas>
  <span class="band__label band__label--tl">SCAN · PERFIL · 7.3 MHz</span>
  <span class="band__label band__label--br">KEY-1</span>
</div>

<script>
  import { Stripes } from '../scripts/scan-band';
  import { getPalette } from '../scripts/palette';
  import { afterBoot } from '../scripts/boot';

  const band = document.querySelector<HTMLElement>('[data-scan-band]');
  const canvas = band?.querySelector('canvas');
  if (band && canvas) {
    // não anima por baixo do boot
    afterBoot(() => {
      try {
        new Stripes(canvas, { color: () => getPalette()['band-line'], amp: () => 1 }).start();
        band.classList.add('is-live');
      } catch {
        /* fica o fundo em CSS */
      }
    });
  }
</script>

<style>
  .band {
    position: relative;
    height: 150px;
    overflow: hidden;
    background-color: var(--band-bg);
    /* sem JavaScript: linhas retas de 1px a cada 5px */
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0 4px,
      color-mix(in srgb, var(--band-line) 40%, transparent) 4px 5px
    );
  }

  .band.is-live {
    background-image: none;
  }

  .band__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .band__label {
    position: absolute;
    padding: 1px 6px;
    background: var(--band-bg);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--band-fg);
  }

  .band__label--tl {
    left: var(--gutter);
    top: 14px;
  }

  .band__label--br {
    right: var(--gutter);
    bottom: 14px;
  }
</style>
