---
const ano = 2026;
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy">© {ano} CAIO FERREIRA</p>
    <a class="footer__top" href="#topo">Voltar ao topo ↑</a>
  </div>
</footer>

<style>
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px;
  }

  .footer__copy,
  .footer__top {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__top:hover {
    color: var(--accent-text);
  }
</style>
