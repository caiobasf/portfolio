---
/** <head> do estilo brutalista: fontes auto-hospedadas (só latino). */
import archivo from '@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url';
import grotesk from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import { fontFace } from '../fontes';

const css = [fontFace('Archivo Black', '400', archivo), fontFace('Space Grotesk Variable', '300 700', grotesk, true)].join('');
---

<link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={grotesk} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
