---
/**
 * Rabisco original: um dev de óculos atrás do notebook, com caneca de café e
 * uma plantinha. Traço de caneta; os caminhos com .c-traco se desenham no load.
 */
---

<svg class="c-dev c-doodle" viewBox="0 0 420 340" aria-hidden="true">
  <!-- mancha de marca-texto atrás da cabeça -->
  <path class="c-dev__sol" d="M150 78c8-34 52-52 90-40 36 11 52 46 38 78-13 30-58 44-94 32-30-10-42-40-34-70z" fill="#ffe066" opacity=".75"></path>
  <g fill="none" stroke="#22304a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <!-- mesa -->
    <path class="c-traco" d="M14 300c80-4 170 3 250-1 52-2 100 2 144-1"></path>
    <!-- cabeça -->
    <path class="c-traco" d="M212 58c26 0 44 20 43 46-1 28-20 48-45 48-26 0-44-21-43-48 1-27 20-46 45-46z"></path>
    <!-- cabelo -->
    <path class="c-traco" d="M168 98c-2-26 14-46 36-49 10-14 34-12 42 2 14 4 20 18 18 32-10-12-24-16-38-12-14-10-36-6-46 10-4 6-8 12-12 17z"></path>
    <!-- óculos -->
    <path class="c-traco" d="M190 104a11 11 0 1 0 22 0a11 11 0 1 0-22 0zM222 104a11 11 0 1 0 22 0a11 11 0 1 0-22 0zM212 103c3-3 7-3 10 0M190 101l-10-3M244 101l9-4"></path>
    <!-- sorriso -->
    <path class="c-traco" d="M204 128c7 6 17 6 24-1"></path>
    <!-- ombros -->
    <path class="c-traco" d="M188 148c-24 8-42 16-58 34M236 148c26 8 44 18 58 36"></path>
    <!-- notebook (de costas) -->
    <path class="c-traco" d="M124 182c56-3 116-2 176 0l-6 112c-56 2-110 2-164 0z" fill="#fdfbf4"></path>
    <path class="c-traco" d="M104 298c70-4 146-4 216 0"></path>
    <!-- adesivo </> -->
    <path class="c-traco" d="M196 226l-16 13 16 13M228 226l16 13-16 13M218 220l-12 38" stroke="#2b59c3"></path>
    <!-- caneca -->
    <path class="c-traco" d="M336 250c10-1 22-1 32 0l-2 48c-9 1-19 1-28 0z" fill="#ffb3c7"></path>
    <path class="c-traco" d="M367 260c14-2 16 22 0 22"></path>
    <path class="c-traco c-dev__vapor" d="M346 238c-8-8 8-14 0-24M358 238c-8-8 8-14 0-24"></path>
    <!-- planta -->
    <path class="c-traco" d="M34 298l6-36h40l6 36z" fill="#b5f2b0"></path>
    <path class="c-traco" d="M60 262c-2-20 2-36 12-52M60 262c-10-14-22-22-36-26M62 262c6-12 18-20 32-22"></path>
    <path class="c-traco" d="M72 210c10-6 16-2 14 8-6 4-12 2-14-8zM24 236c4-10 14-10 18-2-6 6-12 6-18 2zM94 240c-2-10 8-14 14-8-4 8-10 10-14 8z"></path>
    <!-- brilhos -->
    <path class="c-traco" d="M318 70v20M308 80h20M100 100v14M93 107h14" stroke="#2b59c3"></path>
  </g>
  <!-- balão -->
  <g class="c-dev__balao">
    <path class="c-traco" d="M290 112c-2-18 12-30 50-30s60 10 60 28-20 28-56 28c-8 0-14 0-20-2l-22 14 6-18c-12-4-18-10-18-20z" fill="#fff" stroke="#22304a" stroke-width="2.5" stroke-linejoin="round"></path>
    <text x="345" y="117" text-anchor="middle" font-family="Caveat Variable, cursive" font-size="22" font-weight="700" fill="#22304a">compilou!</text>
  </g>
</svg>
