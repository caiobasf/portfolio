---
/**
 * Estilo "terminal": um shell de verdade num monitor CRT de fósforo.
 *
 * Sem JS, a página mostra uma sessão gravada (neofetch, whoami, projetos,
 * stack, trajetória e contato já "executados"). Com JS, o shell.ts liga o
 * monitor, faz o boot (pulável) e passa a aceitar comandos.
 */
import plex400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plex600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import plex400i from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-italic.woff2?url';
import vt323 from '@fontsource/vt323/files/vt323-latin-400-normal.woff2?url';
import { fontFace } from '../fontes';
import { pessoa, trajetoria } from '../../content/perfil';
import { sessaoGravada, ps1 } from './saidas';
import { quadroHtml, ANGULO_SP } from './globo';

const fontes = [
  fontFace('IBM Plex Mono', '400', plex400),
  fontFace('IBM Plex Mono', '600', plex600),
  fontFace('IBM Plex Mono', '400', plex400i, false, 'italic'),
  fontFace('VT323', '400', vt323),
].join('');

const janelas = [
  { cmd: 'sobre', rotulo: 'sobre' },
  { cmd: 'projetos', rotulo: 'projetos' },
  { cmd: 'stack', rotulo: 'stack' },
  { cmd: 'trajetoria', rotulo: 'trajetória' },
  { cmd: 'contato', rotulo: 'contato' },
];
const alvo = (c: string) => `#cmd-${c}`;

const chips = ['help', 'sobre', 'projetos', 'stack', 'trajetoria', 'contato', 'neofetch', 'tema', 'estilos', 'clear'];
const sessao = sessaoGravada();
const globo = quadroHtml(ANGULO_SP);

/* tabela de processos: a trajetória vista como num monitor de sistema */
const processos = trajetoria.map((t) => {
  const ano = t.periodo.match(/\d{4}/)?.[0] ?? '0000';
  const ativo = /presente/i.test(t.periodo);
  return {
    pid: ano,
    stat: ativo ? 'R' : 'S',
    cmd: `${t.cargo} @ ${t.lugar.split(',')[0]}`,
    ativo,
  };
});
const medidores = [
  { rotulo: 'café', v: 82 },
  { rotulo: 'foco', v: 74 },
  { rotulo: 'curiosidade', v: 91 },
  { rotulo: 'vagas', v: 100, fixo: true },
];
/* tema salvo antes da primeira pintura */
const temaInicial = `try{var t=localStorage.getItem('cf-terminal-tema');if(t==='ambar'||t==='branco')document.documentElement.dataset.fosforo=t}catch(e){}`;
---

<Fragment slot="head">
  <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={vt323} as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={fontes}></style>
  <script is:inline set:html={temaInicial}></script>
</Fragment>

<a class="t-pular" href="#conteudo">Pular para o conteúdo</a>

<div class="t-crt" aria-hidden="true">
  <div class="t-luz"></div>
  <div class="t-cintila"></div>
  <div class="t-scan"></div>
  <div class="t-vinheta"></div>
  <div class="t-moldura"></div>
</div>

<div class="t-raiz">
  <header class="t-tmux">
    <h1 class="t-sessao"><span aria-hidden="true">[</span>{pessoa.nomeCurto}<span aria-hidden="true">]</span></h1>
    <nav class="t-janelas" aria-label="Seções">
      <ol>
        <li><a href="#conteudo" data-cmd="neofetch" data-janela="neofetch"><span class="t-num">0:</span>shell</a></li>
        {
          janelas.map((j, i) => (
            <li>
              <a href={alvo(j.cmd)} data-cmd={j.cmd} data-janela={j.cmd}>
                <span class="t-num">{i + 1}:</span>
                {j.rotulo}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="t-relogio" aria-hidden="true"><span data-relogio>tty1</span></p>
  </header>

  <div class="t-corpo">
  <main id="conteudo" class="t-tela" tabindex="-1">
    <div id="t-log" class="t-log" role="log" aria-live="polite" aria-label="Saída do terminal">
      <div class="t-gravado">
        <p class="l t-dim t-nota">
          Sessão gravada de caiobasf-sh 4.0. Com JavaScript ativo, este terminal aceita comandos: digite{' '}
          <span class="t-hl">help</span>.
        </p>
        <Fragment set:html={sessao} />
      </div>
    </div>

    <div class="t-painel">
      <div class="t-chips" role="group" aria-label="Comandos rápidos">
        {
          chips.map((c) => (
            <a class="t-chip" href={c === 'help' || c === 'tema' || c === 'clear' || c === 'estilos' ? '#t-log' : alvo(c === 'sobre' ? 'sobre' : c)} data-cmd={c}>
              {c}
            </a>
          ))
        }
      </div>

      <form id="t-form" class="t-prompt" hidden autocomplete="off">
        <label for="t-entrada" class="t-ps1">
          <span class="t-sr">Digite um comando do terminal</span>
          <span id="t-ps1" aria-hidden="true" set:html={ps1()} />
        </label>
        <div class="t-campo">
          <input
            id="t-entrada"
            name="comando"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="send"
          />
          <span class="t-cursor" id="t-cursor" aria-hidden="true"> </span>
        </div>
        <button type="submit" class="t-enter">enter</button>
      </form>

      <p class="t-semjs" data-sem-js>
        <span set:html={ps1()} /> <span class="t-bloco-cursor" aria-hidden="true"> </span>
      </p>
    </div>
  </main>

  <aside class="t-monitor" aria-label="Monitor do sistema">
    <p class="t-pane-tit"><span aria-hidden="true">-- </span>monitor<span aria-hidden="true"> --</span></p>
    <pre class="t-globo" aria-hidden="true" data-globo set:html={globo} />
    <p class="t-coord">
      <span class="t-hl">{pessoa.local}</span><br /><span class="t-dim">23°33'S · 46°38'O · UTC-3</span>
    </p>
    <div class="t-medidores" aria-hidden="true">
      {
        medidores.map((m) => (
          <p class="t-medidor" data-medidor={m.fixo ? undefined : m.v}>
            <span class="t-med-rot">{m.rotulo}</span>
            <span class="t-med-barra">[<span data-barra>{'|'.repeat(Math.round(m.v / 5)).padEnd(20, ' ')}</span>]</span>
            <span class="t-med-v" data-valor>{m.v}%</span>
          </p>
        ))
      }
    </div>
    <table class="t-proc">
      <caption>processos (trajetória)</caption>
      <thead>
        <tr><th scope="col">PID</th><th scope="col">ST</th><th scope="col">COMANDO</th></tr>
      </thead>
      <tbody>
        {
          processos.map((p) => (
            <tr class={p.ativo ? 't-proc-ativo' : undefined}>
              <td>{p.pid}</td>
              <td><abbr title={p.ativo ? 'em execução' : 'concluído'}>{p.stat}</abbr></td>
              <td>{p.cmd}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </aside>
  <footer class="t-rodape">
    <p>
      <span class="t-dim">caiobasf-sh 4.0</span> · feito à mão em {pessoa.local} ·{' '}
      <span class="t-dim">Tab completa · ↑↓ histórico · Ctrl+L limpa · Esc pula</span>
    </p>
  </footer>
  </div>

</div>

<script>
  import './shell';
  import './monitor';
</script>

<style is:global>
  html[data-estilo='terminal'] {
    --bg: #030a04;
    --bg2: #07170b;
    --fg: #7dff9b;
    --hl: #ffb000;
    --dim: #45ad62;
    --ok: #7dff9b;
    --bz: 12px;
    --raio: 26px;
    color-scheme: dark;
    scrollbar-color: var(--dim) var(--bg);
    scroll-padding-top: 64px;
  }
  html[data-estilo='terminal'][data-fosforo='ambar'] {
    --bg: #0c0700;
    --bg2: #1a1003;
    --fg: #ffb000;
    --hl: #fff0c2;
    --dim: #c08a14;
    --ok: #ffd36b;
  }
  html[data-estilo='terminal'][data-fosforo='branco'] {
    --bg: #06080a;
    --bg2: #12161a;
    --fg: #e4ece8;
    --hl: #8fe3ff;
    --dim: #93a39b;
    --ok: #b9ffd0;
  }

  /* reset próprio */
  html[data-estilo='terminal'],
  html[data-estilo='terminal'] body {
    margin: 0;
    padding: 0;
  }
  html[data-estilo='terminal'] *,
  html[data-estilo='terminal'] *::before,
  html[data-estilo='terminal'] *::after {
    box-sizing: border-box;
  }
  html[data-estilo='terminal'] :where(h1, h2, h3, p, ul, ol, dl, dd, pre, figure) {
    margin: 0;
    padding: 0;
    font: inherit;
  }
  html[data-estilo='terminal'] :where(ul, ol) {
    list-style: none;
  }
  html[data-estilo='terminal'] :where(button, input) {
    font: inherit;
    color: inherit;
  }

  html[data-estilo='terminal'] body {
    min-height: 100dvh;
    background:
      radial-gradient(ellipse 90% 70% at 50% 45%, var(--bg2) 0%, var(--bg) 72%) fixed,
      var(--bg);
    color: var(--fg);
    font-family: 'IBM Plex Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: clamp(16px, 0.85rem + 0.2vw, 17.5px);
    line-height: 1.6;
    text-shadow:
      0 0 1px color-mix(in srgb, var(--fg) 70%, transparent),
      0 0 7px color-mix(in srgb, var(--fg) 38%, transparent);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  html[data-estilo='terminal'] ::selection {
    background: var(--fg);
    color: var(--bg);
    text-shadow: none;
  }
  html[data-estilo='terminal'] :focus-visible {
    outline: 2px solid var(--hl);
    outline-offset: 2px;
    text-shadow: none;
  }
  html[data-estilo='terminal'] .t-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  html[data-estilo='terminal'] .t-pular {
    position: fixed;
    left: 24px;
    top: 24px;
    z-index: 100;
    padding: 6px 12px;
    background: var(--hl);
    color: var(--bg);
    text-shadow: none;
    transform: translateY(-200%);
  }
  html[data-estilo='terminal'] .t-pular:focus {
    transform: none;
  }

  /* ------------------------------------------------------ o tubo de raios */
  html[data-estilo='terminal'] .t-crt {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 60;
  }
  html[data-estilo='terminal'] .t-crt > * {
    position: absolute;
    inset: 0;
  }
  html[data-estilo='terminal'] .t-scan {
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.32) 2px 3px);
  }
  html[data-estilo='terminal'] .t-vinheta {
    background:
      linear-gradient(128deg, rgba(255, 255, 255, 0.045) 0%, transparent 28%),
      radial-gradient(ellipse 110% 100% at 50% 50%, transparent 58%, rgba(0, 0, 0, 0.5) 88%, rgba(0, 0, 0, 0.8) 100%);
  }
  html[data-estilo='terminal'] .t-moldura {
    inset: var(--bz);
    border-radius: var(--raio) / calc(var(--raio) * 1.3);
    box-shadow:
      0 0 0 100vmax #010201,
      inset 0 0 0 1px rgba(255, 255, 255, 0.04),
      inset 0 0 70px 12px rgba(0, 0, 0, 0.75),
      inset 0 0 18px 2px color-mix(in srgb, var(--fg) 9%, transparent);
  }
  html[data-estilo='terminal'] .t-luz {
    inset: auto 0 auto 0;
    top: 0;
    height: 22vh;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--fg) 5%, transparent) 70%,
      color-mix(in srgb, var(--fg) 9%, transparent) 96%,
      transparent
    );
    transform: translateY(-30vh);
  }
  html[data-estilo='terminal'] .t-cintila {
    background: color-mix(in srgb, var(--fg) 3%, transparent);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    html[data-estilo='terminal'] .t-luz {
      animation: t-varre 9s linear infinite;
    }
    html[data-estilo='terminal'] .t-cintila {
      animation: t-cintila 5s steps(1) infinite;
    }
  }
  @keyframes t-varre {
    to {
      transform: translateY(110vh);
    }
  }
  @keyframes t-cintila {
    0%,
    100% {
      opacity: 0.2;
    }
    7% {
      opacity: 0.55;
    }
    9% {
      opacity: 0.1;
    }
    31% {
      opacity: 0.4;
    }
    33% {
      opacity: 0.15;
    }
    62% {
      opacity: 0.5;
    }
    64% {
      opacity: 0.2;
    }
    86% {
      opacity: 0.35;
    }
  }

  /* --------------------------------------------------------- estrutura */
  html[data-estilo='terminal'] .t-raiz {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: var(--bz);
  }

  /* barra de status no estilo multiplexador: nome da sessão e janelas */
  html[data-estilo='terminal'] .t-tmux {
    position: sticky;
    top: var(--bz);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 6px 18px;
    flex-wrap: wrap;
    margin: 0 0 4px;
    padding: 6px calc(var(--raio) * 0.9) 4px;
    border-radius: var(--raio) var(--raio) 0 0 / calc(var(--raio) * 1.3) calc(var(--raio) * 1.3) 0 0;
    background: var(--fg);
    color: var(--bg);
    font-family: 'VT323', ui-monospace, monospace;
    font-size: 22px;
    line-height: 1.1;
    text-shadow: none;
    box-shadow: 0 0 22px color-mix(in srgb, var(--fg) 35%, transparent);
  }
  html[data-estilo='terminal'] .t-sessao {
    font-size: 22px;
    font-weight: 400;
    padding: 1px 8px;
    background: var(--bg);
    color: var(--fg);
    white-space: nowrap;
  }
  html[data-estilo='terminal'] .t-janelas ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
  }
  html[data-estilo='terminal'] .t-janelas a {
    display: inline-block;
    padding: 1px 7px;
    color: var(--bg);
    text-decoration: none;
  }
  html[data-estilo='terminal'] .t-janelas a:hover {
    background: color-mix(in srgb, var(--bg) 18%, var(--fg));
  }
  html[data-estilo='terminal'] .t-janelas a[data-ativa] {
    background: var(--bg);
    color: var(--hl);
  }
  html[data-estilo='terminal'] .t-janelas a[data-ativa]::after {
    content: '*';
  }
  html[data-estilo='terminal'] .t-janelas a:focus-visible {
    outline: 2px solid var(--bg);
    outline-offset: -2px;
  }
  html[data-estilo='terminal'] .t-relogio {
    margin-left: auto;
    white-space: nowrap;
  }


  /* --------------------------------------------- painel do monitor (tmux) */
  html[data-estilo='terminal'] .t-corpo {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  html[data-estilo='terminal'] .t-monitor {
    display: none;
  }
  @media (min-width: 1200px) {
    html[data-estilo='terminal'] .t-corpo {
      grid-template-columns: minmax(0, 1fr) 400px;
      grid-template-rows: 1fr auto;
    }
    html[data-estilo='terminal'] .t-rodape {
      grid-column: 1;
    }
    html[data-estilo='terminal'] .t-monitor {
      display: flex;
      flex-direction: column;
      gap: 14px;
      grid-column: 2;
      grid-row: 1 / 3;
      position: sticky;
      top: calc(var(--bz) + 44px);
      align-self: start;
      max-height: calc(100dvh - var(--bz) * 2 - 60px);
      overflow: hidden;
      margin: 18px calc(var(--raio) * 0.6) 0 0;
      padding: 14px 18px 18px 22px;
      border-left: 1px solid var(--fg);
      font-size: 14.5px;
      line-height: 1.45;
    }
  }
  html[data-estilo='terminal'] .t-pane-tit {
    font-family: 'VT323', ui-monospace, monospace;
    font-size: 20px;
    color: var(--dim);
    letter-spacing: 0.06em;
  }
  html[data-estilo='terminal'] .t-globo {
    font-size: 11.5px;
    line-height: 1.02;
    letter-spacing: 0.04em;
    color: var(--fg);
    white-space: pre;
    margin: 0 auto;
    text-shadow:
      0 0 1px color-mix(in srgb, var(--fg) 80%, transparent),
      0 0 9px color-mix(in srgb, var(--fg) 55%, transparent);
  }
  html[data-estilo='terminal'] .t-globo b {
    font-weight: 600;
    color: var(--hl);
    text-shadow: 0 0 10px var(--hl);
  }
  html[data-estilo='terminal'] .t-coord {
    text-align: center;
  }
  html[data-estilo='terminal'] .t-medidores {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  html[data-estilo='terminal'] .t-medidor {
    display: grid;
    grid-template-columns: 12ch auto 1fr;
    gap: 1ch;
    white-space: pre;
  }
  html[data-estilo='terminal'] .t-med-barra {
    color: var(--dim);
  }
  html[data-estilo='terminal'] .t-med-barra [data-barra] {
    color: var(--fg);
  }
  html[data-estilo='terminal'] .t-medidor:last-child [data-barra],
  html[data-estilo='terminal'] .t-medidor:last-child .t-med-v {
    color: var(--hl);
  }
  html[data-estilo='terminal'] .t-med-v {
    text-align: right;
  }
  html[data-estilo='terminal'] .t-proc {
    border-collapse: collapse;
    width: 100%;
  }
  html[data-estilo='terminal'] .t-proc caption {
    text-align: left;
    color: var(--dim);
    padding-bottom: 4px;
  }
  html[data-estilo='terminal'] .t-proc th {
    background: var(--fg);
    color: var(--bg);
    text-shadow: none;
    font-weight: 600;
    text-align: left;
    padding: 0 6px;
  }
  html[data-estilo='terminal'] .t-proc td {
    padding: 2px 6px;
    vertical-align: top;
  }
  html[data-estilo='terminal'] .t-proc abbr {
    text-decoration: none;
  }
  html[data-estilo='terminal'] .t-proc-ativo td {
    color: var(--hl);
  }

  html[data-estilo='terminal'] .t-tela {
    flex: 1;
    width: 100%;
    max-width: 112ch;
    padding: clamp(18px, 3vw, 36px) clamp(18px, 4vw, 52px) 8px;
    outline: none;
  }
  html[data-estilo='terminal'] .t-log {
    display: flex;
    flex-direction: column;
    gap: 1.35em;
  }
  html[data-estilo='terminal'] .t-gravado {
    display: flex;
    flex-direction: column;
    gap: 1.6em;
  }

  /* --------------------------------------------------------- tipografia */
  html[data-estilo='terminal'] .t-dim {
    color: var(--dim);
  }
  html[data-estilo='terminal'] .t-hl,
  html[data-estilo='terminal'] .t-amb {
    color: var(--hl);
    text-shadow:
      0 0 1px color-mix(in srgb, var(--hl) 70%, transparent),
      0 0 8px color-mix(in srgb, var(--hl) 45%, transparent);
  }
  html[data-estilo='terminal'] .t-u {
    color: var(--hl);
  }
  html[data-estilo='terminal'] .t-d {
    color: var(--fg);
    font-weight: 600;
  }
  html[data-estilo='terminal'] .t-k {
    color: var(--hl);
  }
  html[data-estilo='terminal'] .t-k-larg {
    display: inline-block;
    min-width: 10ch;
  }
  html[data-estilo='terminal'] .t-ok {
    color: var(--ok);
    font-weight: 600;
  }
  html[data-estilo='terminal'] .t-led {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-right: 0.5ch;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 8px var(--ok);
  }
  @media (prefers-reduced-motion: no-preference) {
    html[data-estilo='terminal'] .t-led {
      animation: t-pisca 1.6s ease-in-out infinite;
    }
  }
  @keyframes t-pisca {
    50% {
      opacity: 0.35;
    }
  }
  html[data-estilo='terminal'] kbd {
    font: inherit;
    padding: 0 0.4ch;
    border: 1px solid var(--dim);
    margin: 0 1px;
  }
  html[data-estilo='terminal'] a {
    color: var(--fg);
    text-decoration: underline dotted 1px;
    text-underline-offset: 3px;
  }
  html[data-estilo='terminal'] .t-out a:hover,
  html[data-estilo='terminal'] .t-rodape a:hover {
    background: var(--fg);
    color: var(--bg);
    text-shadow: none;
    text-decoration: none;
  }

  /* linha de comando ecoada */
  html[data-estilo='terminal'] .t-eco {
    font-weight: 400;
    word-break: break-word;
  }
  html[data-estilo='terminal'] .t-eco-cmd {
    color: var(--fg);
    font-weight: 600;
  }
  html[data-estilo='terminal'] .t-out {
    margin-top: 0.45em;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }
  html[data-estilo='terminal'] .t-out .l {
    width: fit-content;
    max-width: 100%;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  html[data-estilo='terminal'] .t-par {
    max-width: 78ch !important;
  }
  html[data-estilo='terminal'] .t-nota {
    border-left: 2px solid var(--dim);
    padding-left: 1.5ch;
  }

  /* atalhos clicáveis dentro das saídas */
  html[data-estilo='terminal'] .t-cmd {
    display: inline;
    padding: 0 0.3ch;
    margin: 0 -0.3ch;
    border: 0;
