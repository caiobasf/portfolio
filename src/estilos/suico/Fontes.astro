---
/** Inter Tight variável (100–900), só o subconjunto latino, pré-carregada. */
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import { fontFace } from '../fontes';

const css = fontFace('Inter Tight Variable', '100 900', interTight, true);
---

<link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
