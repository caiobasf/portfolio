---
/**
 * Press Start 2P (logo, START e números: a fonte achata as maiúsculas acentuadas,
 * então fica só onde não há acento), Silkscreen (títulos e rótulos em português),
 * Pixelify Sans (texto) e VT323 (números/legendas).
 */
import press from '@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2?url';
import sk4 from '@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url';
import sk7 from '@fontsource/silkscreen/files/silkscreen-latin-700-normal.woff2?url';
import vt from '@fontsource/vt323/files/vt323-latin-400-normal.woff2?url';
import pixelify from '@fontsource-variable/pixelify-sans/files/pixelify-sans-latin-wght-normal.woff2?url';
import { fontFace } from '../fontes';

const css = [
  fontFace('Press Start 2P', '400', press),
  fontFace('Silkscreen', '400', sk4),
  fontFace('Silkscreen', '700', sk7),
  fontFace('VT323', '400', vt),
  fontFace('Pixelify Sans Variable', '400 700', pixelify, true),
].join('');
---

<link rel="preload" href={press} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={sk7} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={pixelify} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
