---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Projetos from '../components/Projetos.astro';
import Stack from '../components/Stack.astro';
import Trajetoria from '../components/Trajetoria.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
import Boot from '../components/Boot.astro';
import ScanBand from '../components/ScanBand.astro';
---

<Base boot person redirecionaEstilo>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo" tabindex="-1">
    <Hero />
    <ScanBand />
    <Sobre />
    <Projetos />
    <Stack />
    <Trajetoria />
    <Contato />
  </main>
  <Footer />
  <Boot />
</Base>

<script>
  // Revelação em mosaico só na landing (boot e chat não carregam este módulo)
  import { initMosaic } from '../scripts/mosaic';

  initMosaic(Array.from(document.querySelectorAll<HTMLElement>('[data-mosaic]')));
</script>
